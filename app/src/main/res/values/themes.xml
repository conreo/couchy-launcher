<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LiteTV" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <!-- Splash: drawn by the system the instant the app starts -->
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!-- ADB backup: no splash flash, activity finishes as soon as the file I/O is done. -->
    <style name="Theme.LiteTV.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
